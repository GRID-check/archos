  "$defs": {
    "CrossProjectSearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "scope": {
          "default": "similar",
          "type": "string",
          "enum": [
            "similar",
            "closed",
            "all",
            "named"
          ]
        },
        "projectIds": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "documentTypes": {
          "default": [],
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Bebauungsplan",
              "Flächenwidmungsplan",
              "Grundriss",
              "Schnitt",
              "Ansicht",
              "Detail",
              "Gutachten",
              "Bescheid",
              "Norm/Richtlinie",
              "Vertrag",
              "Foto",
              "Sonstiges"
            ]
          }
        },
        "disciplines": {
          "default": [],
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Standsicherheit",
              "Brandschutz",
              "Hygiene/Gesundheit/Umweltschutz",
              "Nutzungssicherheit/Barrierefreiheit",
              "Schallschutz",
              "Energieeinsparung/Wärmeschutz"
            ]
          }
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "answerMessageId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "openFoldersOnly": {
          "default": false,
          "type": "boolean"
        },
        "order": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "projectFacts": {
          "type": "object",
          "properties": {
            "federal_state": {
              "minItems": 1,
              "maxItems": 9,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "vienna",
                  "lower_austria",
                  "upper_austria",
                  "styria",
                  "carinthia",
                  "salzburg",
                  "tyrol",
                  "vorarlberg",
                  "burgenland"
                ]
              }
            },
            "building_class": {
              "minItems": 1,
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "construction_method": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "masonry_solid",
                  "reinforced_concrete",
                  "timber",
                  "steel"
                ]
              }
            },
            "uses": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "residential",
                  "office",
                  "retail",
                  "catering",
                  "lodging",
                  "assembly",
                  "education",
                  "healthcare",
                  "production",
                  "garage",
                  "agriculture",
                  "technical"
                ]
              }
            },
            "work_type": {
              "minItems": 1,
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "new_build",
                  "extension",
                  "conversion",
                  "refurbishment",
                  "change_of_use",
                  "demolition",
                  "external_works"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "query"
      ]
    },
