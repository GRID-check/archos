# Throwaway image: install deps (fast/reliable in Docker) and run the TS typecheck.
# Build once (deps cached), then `docker run` to get the full error list.
# Uses a public node image so it needs no registry auth.
FROM node:22-slim
# Bun installs and type checks (`bun check`, ADR-0103). See deploy/Dockerfile
# for why the base is still a Node image rather than an `oven/bun` one.
COPY --from=oven/bun:1.4.3-slim /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY package.json bun.lock ./
# `patchedDependencies` in package.json: bun applies these while installing.
COPY patches ./patches
RUN bun install --frozen-lockfile --ignore-scripts
COPY . .
CMD ["bun", "check", "--all"]
