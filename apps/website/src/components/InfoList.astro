---
/** A piece of a value: plain text, an inline link, or a line break (the Impressum address). */
export type InfoSegment = string | { text: string; href: string } | { br: true };

interface InfoItem {
  key: string;
  /** Plain text, or a list of segments for inline links and line breaks */
  value: string | InfoSegment[];
  /** Makes the whole value a link, e.g. a mailto: address */
  href?: string;
}

interface Props {
  items: InfoItem[];
  /** With a title: heading-2 left, rows right (Impressum, Datenschutz) */
  title?: string;
  class?: string;
}

const { items, title, class: className } = Astro.props;
---

{
  title ? (
    <div class:list={['ui-rows', className]}>
      <h2 class="heading-2">{title}</h2>
      <ul class="ui-info body">
        {items.map((item) => (
          <li>
            <p class="ui-info-k">{item.key}</p>
            <p class="ui-info-v">
              {item.href ? (
                <a class="ui-link" href={item.href}>{item.value as string}</a>
              ) : typeof item.value === 'string' ? (
                item.value
              ) : (
                item.value.map((s) =>
                  typeof s === 'string' ? s : 'br' in s ? <br /> : <a class="ui-link" href={s.href}>{s.text}</a>,
                )
              )}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <ul class:list={['ui-info', 'body', className]}>
      {items.map((item) => (
        <li>
          <p class="ui-info-k">{item.key}</p>
          <p class="ui-info-v">
            {item.href ? (
              <a class="ui-link" href={item.href}>{item.value as string}</a>
            ) : typeof item.value === 'string' ? (
              item.value
            ) : (
              item.value.map((s) =>
                typeof s === 'string' ? s : 'br' in s ? <br /> : <a class="ui-link" href={s.href}>{s.text}</a>,
              )
            )}
          </p>
        </li>
      ))}
    </ul>
  )
}
