---
export interface TimelineStep {
  when: string;
  text?: string;
}

interface Props {
  steps: TimelineStep[];
  /** Index of today's step, default 0 */
  current?: number;
  class?: string;
}

const { steps, current = 0, class: className } = Astro.props;
---

<ol class:list={['ui-timeline', className]} style={`--ui-cols: ${steps.length || 3}`}>
  {
    steps.map((step, i) => (
      <li class="ui-timeline-step" aria-current={i === current ? 'step' : undefined}>
        <span class="ui-timeline-bar" aria-hidden="true" />
        <h3 class="ui-timeline-when heading-3">{step.when}</h3>
        {step.text && <p class="ui-timeline-text body">{step.text}</p>}
      </li>
    ))
  }
</ol>
