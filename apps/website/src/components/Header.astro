---
import identity from '../lib/identity';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';
import { demoLink, loginLink, mainNav, type NavLink } from '../lib/nav';

interface Props {
  /** Plattform · Datensicherheit · Blog */
  links?: NavLink[];
  /** href of the active page */
  current?: string;
  /** Small secondary button, e.g. Login */
  login?: NavLink | null;
  /** Small primary button, e.g. Demo anfragen: the page's one primary */
  cta?: NavLink | null;
  homeHref?: string;
  /** default true: stays on top with the glass background */
  sticky?: boolean;
  class?: string;
}

const {
  links = mainNav,
  current,
  login = loginLink,
  cta = demoLink,
  homeHref = '/',
  sticky = true,
  class: className,
} = Astro.props;
const hasMenu = links.length > 0 || Boolean(login);
---

<header class:list={['ui-header', !sticky && 'ui-header-static', className]}>
  <div class="ui-wide ui-header-inner">
    <Wordmark href={homeHref} size="sm" aria-label={`${identity.name} – Startseite`} />
    {
      links.length ? (
        <nav class="ui-nav" aria-label="Hauptnavigation">
          <ul>
            {links.map((link) => (
              <li>
                <a class="ui-nav-link" href={link.href} aria-current={link.href === current ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <span />
      )
    }
    <div class="ui-header-actions">
      {login && (
        <Button href={login.href} variant="secondary" size="sm">
          {login.label}
        </Button>
      )}
      {cta && (
        <Button href={cta.href} variant="primary" size="sm">
          {cta.label}
        </Button>
      )}
      {
        hasMenu && (
          <details class="ui-mnav">
            <summary class="ui-btn ui-btn-secondary ui-btn-sm" aria-label="Menü">
              <span class="ui-mnav-o">Menü</span>
              <span class="ui-mnav-x">Schließen</span>
            </summary>
            <nav class="ui-mnav-panel" aria-label="Menü">
              <ul>
                {links.map((link) => (
                  <li>
                    <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="ui-mnav-act">
                {login && (
                  <Button href={login.href} variant="secondary" size="lg">
                    {login.label}
                  </Button>
                )}
                {cta && (
                  <Button href={cta.href} variant="primary" size="lg">
                    {cta.label}
                  </Button>
                )}
              </div>
            </nav>
          </details>
        )
      }
    </div>
  </div>
</header>

<script>
  // Closes the mobile menu when a link in it is followed (ported from the reference site).
  document.querySelectorAll<HTMLDetailsElement>('.ui-mnav').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });
  });
</script>
