---
/**
 * The shared frame every blog figure sits in: a sunken ground, a kicker line
 * and an optional caption. Strokes and labels come from the design
 * tokens, so a figure inherits the brand by construction.
 *
 * The drawings are 960 units wide with 11-unit labels, so they are legible only
 * near full size. From `xl` (1280px) up the figure breaks out of the text column to give
 * them that. Below `xl` a figure that fills the `mobile` slot shows that
 * instead: the same content re-set as an HTML flow in the `fpm-*` vocabulary,
 * rather than a drawing scaled down until its labels are 3px high.
 */
interface Props {
  /** Short tag rendered above the drawing, e.g. "ABB. 01". */
  kicker?: string
  /** Title next to the kicker. */
  title?: string
  /** Sentence under the figure, rendered as the visible caption. */
  caption?: string
  /** Accessible description of the drawing. Required: SVG text is not enough. */
  alt: string
}
const { kicker, title, caption, alt } = Astro.props
const hasMobile = Astro.slots.has('mobile')
---

<figure class:list={['fig-frame', hasMobile && 'fig-frame--has-mobile']}>
  {
    (kicker || title) && (
      <div class="fig-frame__head" aria-hidden="true">
        {kicker && <span class="fig-frame__kicker">{kicker}</span>}
        {title && <span class="fig-frame__title">{title}</span>}
      </div>
    )
  }
  <div class="fig-frame__canvas" role="img" aria-label={alt}>
    <slot />
  </div>
  {
    hasMobile && (
      <div class="fig-frame__mobile" role="img" aria-label={alt}>
        <slot name="mobile" />
      </div>
    )
  }
  {caption && <figcaption class="fig-frame__caption">{caption}</figcaption>}
</figure>

<style is:global>
  .fig-frame {
    margin: 2.4em 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface-sunken);
  }
  .fig-frame__head {
    display: flex;
    gap: 1em;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--line-strong);
    padding: 10px 16px;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .fig-frame__kicker {
    color: var(--ink);
  }
  .fig-frame__title {
    color: var(--ink-muted);
    text-align: right;
  }
  .fig-frame__canvas {
    padding: 34px 22px;
    background-color: var(--surface-sunken);
  }
  .fig-frame__caption {
    border-top: 1px solid var(--line-strong);
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .fig-frame svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Break out of the text column so a 960-unit drawing renders at about 1:1
     and its 11-unit labels at about 11px. The column starts at the container's
     left edge, so the figure grows to the right from there and stays inside the
     container (content width 1216px). */
  @media (min-width: 1280px) {
    .fig-frame {
      width: min(1040px, calc(100vw - 2 * var(--gutter-wide)));
      max-width: none;
    }
  }

  /* The phone and tablet variant. */
  .fig-frame__mobile {
    display: none;
    padding: 20px 12px;
    background-color: var(--surface-sunken);
  }
  @media (max-width: 1279.98px) {
    .fig-frame--has-mobile .fig-frame__canvas {
      display: none;
    }
    .fig-frame--has-mobile .fig-frame__mobile {
      display: block;
    }
  }
  .fig-frame .fpm-flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 30rem;
    margin: 0 auto;
  }
  .fig-frame .fpm-box {
    border: 1.25px solid var(--ink);
    border-radius: 0;
    background: var(--surface);
    padding: 10px 12px;
  }
  .fig-frame .fpm-box--soft {
    background: var(--surface-raised);
  }
  .fig-frame .fpm-box--tint {
    background: var(--line);
  }
  .fig-frame .fpm-box--dash {
    border-style: dashed;
  }
  .fig-frame .fpm-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .fig-frame .fpm-row > .fpm-box {
    padding-inline: 10px;
  }
  .fig-frame .fpm-head {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
    justify-content: space-between;
  }
  .fig-frame .fpm-label,
  .fig-frame .fpm-sub,
  .fig-frame .fpm-accent {
    display: block;
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .fig-frame .fpm-label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink);
  }
  .fig-frame .fpm-sub {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-muted);
  }
  .fig-frame .fpm-accent {
    font-size: 11px;
    line-height: 1.4;
    color: var(--ink);
  }
  .fig-frame .fpm-no {
    margin-right: 8px;
    color: var(--ink-muted);
  }
  /* A vertical connector with an arrowhead; `--dash` for a side feed. */
  .fig-frame .fpm-arrow {
    position: relative;
    height: 22px;
  }
  .fig-frame .fpm-arrow::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 5px;
    left: 50%;
    border-left: 1.25px solid var(--ink);
  }
  .fig-frame .fpm-arrow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: calc(50% - 4px);
    border: 4px solid transparent;
    border-top: 6px solid var(--ink);
    border-bottom: 0;
  }
  .fig-frame .fpm-arrow--dash::before {
    border-left-style: dashed;
  }
  .fig-frame .fpm-note {
    margin-top: 10px;
    text-align: center;
  }

  /* Drawing vocabulary. Labels are authored in uppercase in the markup;
     SVG text does not reliably obey text-transform. */
  .fig-frame .fp-stroke {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
  }
  .fig-frame .fp-stroke--muted {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .fig-frame .fp-dash {
    stroke-dasharray: 4 4;
  }
  .fig-frame .fp-fill {
    fill: var(--surface);
  }
  .fig-frame .fp-fill--soft {
    fill: var(--surface-raised);
  }
  .fig-frame .fp-fill--tint {
    fill: var(--line);
  }
  .fig-frame .fp-label {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .fig-frame .fp-label--muted {
    fill: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 10.75px;
    letter-spacing: 0.02em;
  }
  .fig-frame .fp-label--accent {
    fill: var(--ink);
    font-family: var(--font-sans);
    font-size: 10.75px;
    letter-spacing: 0.02em;
  }
</style>
