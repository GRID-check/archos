---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import InfoList from '../components/InfoList.astro';
import Input from '../components/Input.astro';
import TextLink from '../components/TextLink.astro';
import { navigation } from '../i18n/nav';
import copy from '../i18n/pages/contact';
import { localePath, type Locale } from '../i18n/paths';
import identity, { withName } from '../lib/identity';
import { format } from '../i18n/ui';

// Markup and structure only. Text comes from src/i18n/pages/contact.ts, in both locales.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = withName(copy[locale]);
const nav = navigation(locale);
const fill = (text: string) => format(text, { ...identity });
const mailto = `mailto:${identity.email}`;
const privacyHref = localePath('privacy', locale);
---

<BaseLayout
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
>
  <Hero title={c.hero.title} text={c.hero.text} />
  <section class="ui-container ui-section page-main">
    <div class="ui-features" style="--ui-cols: 2">
      <div>
        <InfoList
          items={[
            { key: c.info.email, value: identity.email, href: mailto },
            {
              key: c.info.address,
              value: [identity.legalEntity, { br: true }, fill(c.info.addressValue)],
            },
            { key: c.info.linkedin, value: c.info.linkedinValue },
          ]}
        />
        <p class="small">
          {c.info.demoLead} <TextLink href={nav.demo.href}>{nav.demo.label}</TextLink>
        </p>
      </div>
      <form action={mailto} method="post" enctype="text/plain" class="ui-form-grid">
        <Input id="contact-name" name="name" label={c.form.name} autocomplete="name" required class="ui-form-full" />
        <Input
          id="contact-email"
          name="email"
          type="email"
          label={c.form.email}
          autocomplete="email"
          placeholder={c.form.emailPlaceholder}
          required
          class="ui-form-full"
        />
        <Input
          id="contact-office"
          name="office"
          label={c.form.office}
          autocomplete="organization"
          placeholder={c.form.officePlaceholder}
          class="ui-form-full"
        />
        <Input id="contact-message" name="message" label={c.form.message} multiline required class="ui-form-full" />
        <p class="small ui-form-full">
          {c.form.noteBefore} <TextLink href={privacyHref}>{c.form.noteLink}</TextLink>{c.form.noteAfter}
        </p>
        <div class="ui-form-full">
          <Button type="submit" variant="primary" size="lg">{c.form.submit}</Button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
