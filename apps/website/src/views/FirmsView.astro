---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import FeatureTiles from '../components/FeatureTiles.astro';
import Hero from '../components/Hero.astro';
import InfoList from '../components/InfoList.astro';
import LogoRow from '../components/LogoRow.astro';
import SectionIntro from '../components/SectionIntro.astro';
import TextLink from '../components/TextLink.astro';
import { navigation } from '../i18n/nav';
import copy from '../i18n/pages/firms';
import { localePath, type Locale } from '../i18n/paths';
import { t } from '../i18n/ui';
import { withName } from '../lib/identity';
import { PILOT_OFFICES } from '../lib/pilot-offices';

// Markup and structure only. Text comes from src/i18n/pages/firms.ts, in both locales.
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = withName(copy[locale]);
const nav = navigation(locale);
const ui = t(locale);
const security = { label: ui.navSecurity, href: localePath('security', locale), key: 'security' };
// The two abilities with a page of their own link to it; the others are explained on home.
const abilityLinks = [localePath('buildingLaw', locale), localePath('revisions', locale)];
const abilities = c.today.items.map((item, i) => ({ ...item, href: abilityLinks[i] }));
// The journal post that asks the questions this page answers (they link to each other).
const post = locale === 'de' ? '/blog/ki-im-architekturbuero/' : '/en/blog/ai-in-architecture-firms/';
---

<BaseLayout locale={locale} title={c.title} description={c.description} faq={c.faq}>
  <Hero title={c.hero.title} text={c.hero.text} />

  <section class="ui-container page-section">
    <SectionIntro title={c.today.title} text={c.today.text} />
    <img
      src="/media/product-floor-plan-query.webp"
      width="2560"
      height="853"
      loading="lazy"
      decoding="async"
      alt={c.today.imageAlt}
      style="display: block; width: 100%; height: auto; margin: var(--space-8) 0 var(--space-16); background: var(--surface-sunken);"
    />
    <FeatureTiles items={abilities} columns={4} />
  </section>

  <section class="ui-container page-section">
    <InfoList title={c.roles.title} items={c.roles.items} />
  </section>

  <section class="ui-band">
    <div class="ui-container ui-section">
      <SectionIntro title={c.difference.title} text={c.difference.text}>
        <TextLink href={post} arrow>{c.difference.postLink}</TextLink>
      </SectionIntro>
      <FeatureTiles class="page-gap" items={c.difference.items} columns={3} />
    </div>
  </section>

  <section class="ui-container ui-section">
    <SectionIntro title={c.offices.title} text={c.offices.text} />
    <div class="page-gap">
      <LogoRow logos={PILOT_OFFICES} label={c.offices.logosLabel} />
    </div>
  </section>

  <section class="ui-container page-section">
    <FAQ title={c.faqTitle} items={c.faq} />
  </section>

  <section class="ui-container page-section">
    <CTABand title={c.cta.title} text={c.cta.text} primary={nav.demo} secondary={security} area="firms_cta" />
  </section>
</BaseLayout>
