---
import identity from '../lib/identity';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Input from '../components/Input.astro';
import SplitPage from '../components/SplitPage.astro';
import { demoLink } from '../lib/nav';
// Sign-in happens in the app. /sign-in is a server endpoint that resolves the app host at runtime.
---

<BaseLayout bare noindex title="Anmelden" description={`Anmelden bei ${identity.name}.`}>
  <SplitPage
    variant="login"
    image="/media/login-office-photo.webp"
    imageAlt="Leeres Planungsbüro im Abendlicht: Holztisch mit Planrollen und Laptop, Stuhl, Fensterlicht an der Wand"
    ai
    footer={[
      { label: 'Zur Website', href: '/' },
      { label: 'Impressum', href: '/impressum' },
      { label: 'Datenschutz', href: '/datenschutz' },
    ]}
  >
    <h1 class="heading-1" style="margin: 0;">Anmelden.</h1>
    <p class="body" style="margin: var(--space-3) 0 var(--space-12); color: var(--ink-muted);">
      Willkommen zurück bei {identity.name}.
    </p>

    <div class="ui-stack">
      <Button href="/sign-in" size="lg" class="ui-btn-block">Mit Microsoft anmelden</Button>
      <Button href="/sign-in" size="lg" class="ui-btn-block">Mit Google anmelden</Button>
    </div>

    <div class="ui-split-or small" role="separator">oder</div>

    <form method="get" action="/sign-in">
      <Input id="login-mail" name="email" type="email" label="E-Mail" placeholder="name@buero.at" autocomplete="email" required />
      <div style="margin-top: var(--space-4);">
        <Button type="submit" variant="primary" size="lg" class="ui-btn-block">Weiter</Button>
      </div>
    </form>
    <p class="small" style="margin: var(--space-4) 0 0; color: var(--ink-muted);">
      Sie erhalten einen Anmeldelink per E-Mail.
    </p>

    <p class="small" style="margin: var(--space-12) 0 0; color: var(--ink-muted);">
      Noch kein Zugang? <a class="ui-link" href={demoLink.href}>{demoLink.label}</a>
    </p>
  </SplitPage>
</BaseLayout>
