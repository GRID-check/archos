---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import InfoList from '../components/InfoList.astro';
import identity from '../lib/identity';
---

<BaseLayout title="Impressum" description={`Impressum von ${identity.name}: Unternehmensangaben und Offenlegung.`}>
  <Hero
    title="Impressum."
    text="Angaben nach § 5 E-Commerce-Gesetz und § 14 Unternehmensgesetzbuch, Offenlegung nach § 25 Mediengesetz."
  />
  <section class="ui-container ui-section">
    <InfoList
      title="Unternehmen."
      items={[
        { key: 'Firma', value: identity.legalEntity },
        { key: 'Rechtsform', value: 'Flexible Kapitalgesellschaft (FlexCo), in Gründung' },
        { key: 'Sitz', value: identity.city },
        {
          key: 'Anschrift',
          value: `${identity.street}, ${identity.postalCode} ${identity.city}, Österreich`,
        },
        {
          key: 'Firmenbuch',
          value:
            'Noch nicht eingetragen. Firmenbuchnummer, Firmenbuchgericht und UID-Nummer ergänzen wir nach der Eintragung.',
        },
        {
          key: 'Unternehmensgegenstand',
          value: 'Entwicklung und Betrieb von Software für Architektur- und Planungsbüros.',
        },
      ]}
    />
    <InfoList
      title="Kontakt."
      items={[{ key: 'E-Mail', value: identity.email, href: `mailto:${identity.email}` }]}
    />
    <InfoList
      title="Geschäftsführung."
      items={[{ key: 'Geschäftsführer', value: 'Jonathan Uhlemann, Ferdinand Rubenbauer, Matthias Bigl' }]}
    />
    <InfoList
      title="Offenlegung."
      items={[
        { key: 'Medieninhaber', value: `${identity.legalEntity}, ${identity.city}` },
        {
          key: 'Grundlegende Richtung',
          value: `Information über die Software ${identity.name} sowie Beiträge zu Planung, Baurecht und Technologie.`,
        },
      ]}
    />
    <InfoList
      title="Hinweise."
      items={[
        {
          key: 'Inhalte',
          value:
            'Wir erstellen die Inhalte dieser Website mit Sorgfalt, übernehmen aber keine Gewähr für Vollständigkeit und Aktualität. Für Inhalte verlinkter Websites sind deren Betreiber verantwortlich.',
        },
        { key: 'Bilder', value: 'Einzelne Bilder sind mit KI erzeugt und mit „AI“ gekennzeichnet.' },
        {
          key: 'Förderung',
          value: `${identity.name} wird gefördert von der aws – Austria Wirtschaftsservice.`,
        },
      ]}
    />
  </section>
</BaseLayout>
