{
  "about": "Hand-computed cases for the formula card (ADR-0141). Each card validates against cards/models.py (tests/aiq_agent/cards/test_formula_card.py); each is evaluated by frontends/ui/src/features/grid-cards/lib/formulas.ts (formulas.spec.ts). `overrides` are a reader's what-if inputs by slot key; `expect.quantities` were worked out by hand, to the precision `tolerance` allows; `expect.checks` are the verdicts of `card.limits` in order. `targets` is the one list of quantities a limit may name, held equal to FORMULA_TARGETS on both sides.",
  "tolerance": 0.0001,
  "targets": {
    "u_value": ["u_value"],
    "stair_step_rule": ["step_measure", "riser", "going"],
    "escape_route_length": ["route_length"],
    "daylight_ratio": ["daylight_ratio"]
  },
  "cases": [
    {
      "id": "stair-within-the-rule",
      "work": "2 × 17 + 29 = 63 cm, inside 59–65; 17 ≤ 18; 29 ≥ 27",
      "card": {
        "type": "formula",
        "title": "Schrittmaßregel – Stiege Haus A",
        "formula": {
          "name": "stair_step_rule",
          "riser": { "value": 17, "min": 10, "max": 25, "step": 0.5, "source": "Einreichplan, Schnitt A-A" },
          "going": { "value": 29, "min": 20, "max": 40, "step": 0.5, "source": "Einreichplan, Schnitt A-A" }
        },
        "limits": [
          { "target": "step_measure", "comparator": "between", "value": 59, "upper": 65, "label": "Schrittmaßregel", "reference": { "document": "OIB-Richtlinie 4", "section": "Pkt. 3.2.1", "edition": "Ausgabe Mai 2023" } },
          { "target": "riser", "comparator": "<=", "value": 18, "label": "Stufenhöhe", "reference": { "document": "OIB-Richtlinie 4", "section": "Pkt. 3.2.1, Tabelle 3", "edition": "Ausgabe Mai 2023" } },
          { "target": "going", "comparator": ">=", "value": 27, "label": "Stufenauftritt", "reference": { "document": "OIB-Richtlinie 4", "section": "Pkt. 3.2.1, Tabelle 3", "edition": "Ausgabe Mai 2023" } }
        ]
      },
      "expect": { "quantities": { "step_measure": 63, "riser": 17, "going": 29 }, "checks": ["pass", "pass", "pass"] }
    },
    {
      "id": "stair-reader-raises-the-riser",
      "work": "2 × 19 + 29 = 67 cm, above 65; 19 > 18",
      "base": "stair-within-the-rule",
      "overrides": { "riser": 19 },
      "expect": { "quantities": { "step_measure": 67, "riser": 19, "going": 29 }, "checks": ["fail", "fail", "pass"] }
    },
    {
      "id": "stair-going-unknown",
      "work": "the Auftritt is not in the source: no Schrittmaß, no verdict on it; the riser is still judged",
      "base": "stair-within-the-rule",
      "overrides": { "going": null },
      "expect": { "quantities": { "step_measure": null, "riser": 17, "going": null }, "checks": ["needs_input", "pass", "needs_input"] }
    },
    {
      "id": "escape-route-within-40-m",
      "work": "12 + 18,5 + 6 = 36,5 m ≤ 40 m",
      "card": {
        "type": "formula",
        "title": "Gehweglänge – Büro 2.14 bis Treppenhaus",
        "formula": {
          "name": "escape_route_length",
          "segments": [
            { "label": "Büro 2.14 → Gangtür", "length": { "value": 12, "step": 0.5, "source": "Grundriss 2. OG" } },
            { "label": "Gang", "length": { "value": 18.5, "step": 0.5, "source": "Grundriss 2. OG" } },
            { "label": "Vorraum → Treppenhaus", "length": { "value": 6, "step": 0.5, "source": "Grundriss 2. OG" } }
          ]
        },
        "limits": [
          { "target": "route_length", "comparator": "<=", "value": 40, "label": "Gehweglänge", "reference": { "document": "OIB-Richtlinie 2", "section": "Pkt. 5.1.1", "edition": "Ausgabe Mai 2023" } }
        ]
      },
      "expect": { "quantities": { "route_length": 36.5 }, "checks": ["pass"] }
    },
    {
      "id": "escape-route-reader-moves-the-door",
      "work": "12 + 18,5 + 11 = 41,5 m > 40 m",
      "base": "escape-route-within-40-m",
      "overrides": { "segments.2.length": 11 },
      "expect": { "quantities": { "route_length": 41.5 }, "checks": ["fail"] }
    },
    {
      "id": "daylight-above-12-percent",
      "work": "3,1 ÷ 25 × 100 = 12,4 % ≥ 12 %",
      "card": {
        "type": "formula",
        "title": "Lichteintrittsfläche – Wohnzimmer Top 3",
        "formula": {
          "name": "daylight_ratio",
          "glazing_area": { "value": 3.1, "step": 0.05, "source": "Fensterliste, Architekturlichte" },
          "floor_area": { "value": 25, "editable": false, "source": "Raumbuch Top 3" }
        },
        "limits": [
          { "target": "daylight_ratio", "comparator": ">=", "value": 12, "label": "Lichteintrittsfläche", "reference": { "document": "OIB-Richtlinie 3", "section": "Pkt. 9.1.1", "edition": "Ausgabe Mai 2023" } }
        ]
      },
      "expect": { "quantities": { "daylight_ratio": 12.4 }, "checks": ["pass"] }
    },
    {
      "id": "daylight-reader-shrinks-the-window",
      "work": "2,9 ÷ 25 × 100 = 11,6 % < 12 %",
      "base": "daylight-above-12-percent",
      "overrides": { "glazing_area": 2.9 },
      "expect": { "quantities": { "daylight_ratio": 11.6 }, "checks": ["fail"] }
    },
    {
      "id": "daylight-zero-floor-area",
      "work": "a Bodenfläche of 0 has no ratio: undefined, not judged",
      "base": "daylight-above-12-percent",
      "overrides": { "floor_area": 0 },
      "expect": { "quantities": { "daylight_ratio": null }, "undecidable": { "daylight_ratio": "undefined" }, "checks": ["needs_input"] }
    },
    {
      "id": "u-value-wall-20-cm-eps",
      "work": "R_si 0,13 + 0,015/0,70 (0,021429) + 0,18/2,3 (0,078261) + 0,20/0,035 (5,714286) + 0,005/0,70 (0,007143) + R_se 0,04 = 5,991118 m²K/W; U = 1/5,991118 = 0,166914 W/(m²K) ≤ 0,35",
      "card": {
        "type": "formula",
        "title": "U-Wert Außenwand – 20 cm Dämmung",
        "formula": {
          "name": "u_value",
          "heat_flow": "horizontal",
          "layers": [
            { "label": "Innenputz", "thickness": { "value": 1.5, "source": "Wandaufbau AW 01" }, "conductivity": { "value": 0.7, "source": "Produktdatenblatt" } },
            { "label": "Stahlbeton", "thickness": { "value": 18, "source": "Wandaufbau AW 01" }, "conductivity": { "value": 2.3, "source": "Produktdatenblatt" } },
            { "label": "EPS-F", "thickness": { "value": 20, "min": 0, "max": 40, "step": 1, "source": "Wandaufbau AW 01" }, "conductivity": { "value": 0.035, "step": 0.001, "source": "Produktdatenblatt" } },
            { "label": "Außenputz", "thickness": { "value": 0.5, "source": "Wandaufbau AW 01" }, "conductivity": { "value": 0.7, "source": "Produktdatenblatt" } }
          ]
        },
        "limits": [
          { "target": "u_value", "comparator": "<=", "value": 0.35, "label": "Wände gegen Außenluft", "reference": { "document": "OIB-Richtlinie 6", "section": "Pkt. 4.4.1", "edition": "Ausgabe Mai 2023" } }
        ]
      },
      "expect": { "quantities": { "u_value": 0.166914 }, "checks": ["pass"] }
    },
    {
      "id": "u-value-reader-cuts-the-insulation",
      "work": "EPS 4 cm: 0,04/0,035 = 1,142857; R_T = 0,13 + 0,021429 + 0,078261 + 1,142857 + 0,007143 + 0,04 = 1,419689; U = 0,704380 > 0,35",
      "base": "u-value-wall-20-cm-eps",
      "overrides": { "layers.2.thickness": 4 },
      "expect": { "quantities": { "u_value": 0.70438 }, "checks": ["fail"] }
    },
    {
      "id": "u-value-roof-upward-no-limit",
      "work": "upward heat flow, R_si 0,10: 0,10 + 0,30/0,040 (7,5) + 0,20/2,3 (0,086957) + 0,04 = 7,726957; U = 0,129417. No limit given: nothing judged",
      "card": {
        "type": "formula",
        "title": "U-Wert Flachdach",
        "formula": {
          "name": "u_value",
          "heat_flow": "upward",
          "layers": [
            { "label": "Stahlbeton", "thickness": { "value": 20 }, "conductivity": { "value": 2.3 } },
            { "label": "Mineralwolle", "thickness": { "value": 30 }, "conductivity": { "value": 0.04 } }
          ]
        }
      },
      "expect": { "quantities": { "u_value": 0.129417 }, "checks": [] }
    },
    {
      "id": "u-value-zero-conductivity",
      "work": "λ = 0 divides by zero: the layer, R_T and U are undefined",
      "base": "u-value-roof-upward-no-limit",
      "overrides": { "layers.1.conductivity": 0 },
      "expect": { "quantities": { "u_value": null }, "undecidable": { "u_value": "undefined" }, "checks": [] }
    }
  ]
}
