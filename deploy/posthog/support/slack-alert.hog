// Posts Piloti product feedback to Slack and keeps the alert's ts on the ticket.
// Fed by the BFF's server events (frontends/ui/src/lib/product-feedback/service.ts):
//   product_feedback_ticket_opened  -> a new alert, per kind, with a claim button
//   product_feedback_reply_sent     -> a reply in the alert's thread
// Both carry app_host, the deployment the report lives in: staging and production
// share this project, so the claim button must point at the right one.
let props := event.properties
let ticketId := props.ticket_id
if (empty(ticketId)) {
  print('No ticket_id on the event; nothing to post')
  return
}
let host := props.app_host
if (empty(host)) {
  host := inputs.default_host
}
let isProd := host == inputs.default_host

let res := postHogGetTicket({'ticket_id': ticketId, 'include_first_customer_message_text': true})
if (res.status != 200) {
  throw Error(f'Failed to fetch ticket ({res.status}): {res.body}')
}
let ticket := res.body
let number := ticket.ticket_number ?? ticket.number
let slackTs := null
for (let tag in (ticket.tags ?? [])) {
  if (substring(tag, 1, 9) == 'slack-ts:') {
    slackTs := substring(tag, 10, 40)
  }
}

let kind := props.kind
let titles := {
  'bug': '🐞 Neuer Bug-Report',
  'idea': '💡 Neue Idee',
  'praise': '❤️ Neues Lob',
  'question': '❓ Neue Frage'
}
let title := titles[kind] ?? '📝 Neues Feedback'
let ticketUrl := f'https://eu.posthog.com/project/{project.id}/support/tickets/{ticketId}'
let claimUrl := f'https://{host}/app/platform/feedback?claim={ticketId}'
let where := isProd ? '' : f' · 🧪 {host}'

// The report's first message starts with "[kind] #<report id> <path>" for
// PostHog's inbox; Slack shows the member's words without it. PostHog hands the
// first message back with its line breaks folded into spaces, so this works on
// words: drop "[kind]", "#<id>" and a following "/path".
fun withoutHeader(text) {
  if (empty(text) or not match(text, '^\\[[a-z]+\\] #')) {
    return text ?? ''
  }
  let rest := ''
  let i := 0
  for (let word in splitByString(' ', text)) {
    i := i + 1
    let isPath := i == 3 and substring(word, 1, 1) == '/'
    if (i > 2 and not isPath) {
      rest := empty(rest) ? word : f'{rest} {word}'
    }
  }
  return rest
}

fun postToSlack(body) {
  let response := fetch('https://slack.com/api/chat.postMessage', {
    'method': 'POST',
    'headers': {
      'Authorization': f'Bearer {inputs.slack_workspace.access_token}',
      'Content-Type': 'application/json; charset=utf-8'
    },
    'body': body
  })
  if (response.status != 200 or response.body.ok == false) {
    throw Error(f'Slack refused the message: {response.status}: {response.body}')
  }
  return response.body
}

if (event.event == 'product_feedback_ticket_opened') {
  if (not empty(slackTs)) {
    print(f'Ticket {ticketId} has an alert already ({slackTs})')
    return
  }
  let words := substring(withoutHeader(ticket.first_customer_message_text), 1, 2500)
  let quote := empty(words) ? '(kein Text)' : words
  let noContact := props.allow_contact == false ? ' · ⚠️ möchte nicht kontaktiert werden' : ''
  let pageTeam := kind == 'bug' and isProd
  let blocks := []
  if (kind == 'bug') {
    blocks := arrayPushBack(blocks, {'type': 'header', 'text': {'type': 'plain_text', 'text': f'{title} #{number}'}})
    blocks := arrayPushBack(blocks, {'type': 'section', 'text': {'type': 'mrkdwn', 'text': pageTeam ? f'<!here>\n>>> {quote}' : f'>>> {quote}'}})
  } else {
    blocks := arrayPushBack(blocks, {'type': 'section', 'text': {'type': 'mrkdwn', 'text': f'*{title} #{number}*\n>>> {quote}'}})
  }
  blocks := arrayPushBack(blocks, {'type': 'context', 'elements': [{'type': 'mrkdwn', 'text': f'{host}{noContact}'}]})
  let buttons := [
    {'type': 'button', 'style': 'primary', 'text': {'type': 'plain_text', 'text': '🙋 Übernehmen'}, 'url': claimUrl},
    {'type': 'button', 'text': {'type': 'plain_text', 'text': 'Ticket in PostHog öffnen'}, 'url': ticketUrl}
  ]
  if (not empty(person) and not empty(person.url)) {
    buttons := arrayPushBack(buttons, {'type': 'button', 'text': {'type': 'plain_text', 'text': 'Person & Replays'}, 'url': person.url})
  }
  blocks := arrayPushBack(blocks, {'type': 'actions', 'elements': buttons})
  let posted := postToSlack({
    'channel': inputs.channel,
    'username': 'Piloti Feedback',
    'text': pageTeam ? f'<!here> {title} #{number}{where}' : f'{title} #{number}{where}',
    'blocks': blocks
  })
  let tagged := postHogUpdateTicket({
    'ticket_id': ticketId,
    'updates': {'tags': [f'slack-ts:{posted.ts}'], 'tags_mode': 'add'}
  })
  if (tagged.status >= 400) {
    throw Error(f'Alert {posted.ts} posted, but the ticket was not tagged ({tagged.status}): {tagged.body}')
  }
  return
}

if (event.event == 'product_feedback_reply_sent') {
  let words := substring(ticket.last_message_text ?? '', 1, 2500)
  let quote := empty(words) ? '(kein Text)' : words
  let message := {
    'channel': inputs.channel,
    'username': 'Piloti Feedback',
    'text': f'↩️ Antwort vom Reporter auf #{number}{where}',
    'blocks': [
      {'type': 'section', 'text': {'type': 'mrkdwn', 'text': f'*↩️ Antwort vom Reporter auf #{number}*{where}\n>>> {quote}'}},
      {'type': 'actions', 'elements': [
        {'type': 'button', 'style': 'primary', 'text': {'type': 'plain_text', 'text': 'Antworten in PostHog'}, 'url': ticketUrl}
      ]}
    ]
  }
  if (not empty(slackTs)) {
    message.thread_ts := slackTs
    message.reply_broadcast := true
  }
  postToSlack(message)
  return
}

print(f'Event {event.event} is not one this destination posts')
