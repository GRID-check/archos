---
/**
 * The week 41 launch page (/neu, /en/neu): the headline, six themes with the
 * week's own notes, the upgrade notes, and the way to the full changelog. The
 * notes come from src/data/changelog.json through picks.ts; the words around
 * them are in ui.ts (`launch`).
 */
import PageHead from '../molecules/PageHead.astro'
import { PLATES } from '../craft/plates'
import { ui, type Locale } from '../../i18n/ui'
import { launchThemes, launchUpgradeNotes } from './picks'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = ui[locale].launch
const themes = launchThemes(locale)
const upgrade = launchUpgradeNotes(locale)
const changelog = locale === 'en' ? '/en/changelog/' : '/changelog/'
---

<section class="frame pt-28 md:pt-36">
  <p class="m-0 mb-6 font-mono text-xs uppercase tracking-label text-accent-600">{t.kicker}</p>
  <PageHead title={t.heading} plate={PLATES.VI} locale={locale} priority>
    <p class="m-0">{t.lede}</p>
  </PageHead>
</section>

{
  themes.map((theme) => (
    <section aria-labelledby={`launch-${theme.id}`} class="frame section-y">
      <div data-reveal class="grid gap-x-16 gap-y-8 border-t border-ink/15 pt-8 lg:grid-cols-[5fr_7fr]">
        <div>
          <p class="m-0 font-mono text-xs uppercase tracking-label text-accent-600">{t.themes[theme.id].label}</p>
          <h2 id={`launch-${theme.id}`} class="m-0 mt-3 font-voice text-v4 text-ink" style="text-wrap: balance">
            {t.themes[theme.id].heading}
          </h2>
        </div>
        <ul class="m-0 grid list-none gap-x-10 gap-y-9 p-0 sm:grid-cols-2">
          {theme.rows.map(([note, qualifier]) => (
            <li class="border-t border-ink/12 pt-5">
              <p class="m-0 text-base leading-relaxed text-ink">{note}</p>
              {qualifier && <p class="m-0 mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">{qualifier}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))
}

<section aria-labelledby="launch-upgrade" class="frame section-y">
  <div data-reveal class="grid gap-x-16 gap-y-8 border-t border-ink/15 pt-8 lg:grid-cols-[5fr_7fr]">
    <div>
      <h2 id="launch-upgrade" class="m-0 font-voice text-v4 text-ink" style="text-wrap: balance">{t.upgradeHeading}</h2>
      <p class="m-0 mt-4 max-w-measure text-base leading-relaxed text-ink-soft">{t.upgradeLede}</p>
    </div>
    <ul class="m-0 list-none space-y-5 p-0">
      {
        upgrade.map((note) => (
          <li class="border-t border-ink/12 pt-5 text-base leading-relaxed text-ink">{note}</li>
        ))
      }
    </ul>
  </div>
</section>

<section class="frame section-y">
  <div class="flex flex-col gap-4 border-t border-ink/15 pt-8 sm:flex-row sm:items-baseline sm:justify-between">
    <p class="m-0 max-w-measure text-base leading-relaxed text-ink-soft">{t.changelogText}</p>
    <a href={changelog} class="shrink-0 text-accent-600 underline underline-offset-4">{t.changelogLink}&nbsp;→</a>
  </div>
</section>
