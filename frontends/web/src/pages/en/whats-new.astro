---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Launch from '../../components/launch/Launch.astro'
import EndInvite from '../../components/molecules/EndInvite.astro'
import { ui } from '../../i18n/ui'
import { SHARE_ART, pageLd } from '../../lib/seo'

const t = ui.en.seo.pages.neu
---

<BaseLayout
  locale="en"
  title={t.title}
  description={t.description}
  ogArt={SHARE_ART.changelog}
  jsonLd={pageLd('en', t.title, Astro.url.pathname, Astro.site)}
>
  <Launch locale="en" />
  <EndInvite locale="en" page="neu" />
</BaseLayout>

<script>
  import { initReveals } from '../../scripts/reveal'
  initReveals()
</script>
