---
import BaseLayout from '../layouts/BaseLayout.astro'
import Launch from '../components/launch/Launch.astro'
import EndInvite from '../components/molecules/EndInvite.astro'
import { ui } from '../i18n/ui'
import { SHARE_ART, pageLd } from '../lib/seo'

const t = ui.de.seo.pages.neu
---

<BaseLayout
  locale="de"
  title={t.title}
  description={t.description}
  ogArt={SHARE_ART.changelog}
  alternates={{ de: '/neu/', en: '/en/neu/' }}
  jsonLd={pageLd('de', t.title, Astro.url.pathname, Astro.site)}
>
  <Launch locale="de" />
  <EndInvite locale="de" page="neu" />
</BaseLayout>

<script>
  import { initReveals } from '../scripts/reveal'
  initReveals()
</script>
